  "faq": [
    {
      "kerdes": "Mennyibe kerül a gipszkarton 2026-ban?",
      "valasz": "Gipszkarton ára 2026 szeptemberében 2 150–4 100 Ft/lap, a boltok átlagára 3 100 Ft/lap (bruttó, szállítás nélkül). A vizsgált változatok közül a legolcsóbb: Normál (GKB/RB) 12,5 mm 1200×2000 (2 450 Ft), a legdrágább: Impregnált (GKBI/RBI) 12,5 mm 1200×2000 (3 800 Ft)."
    },
    {
      "kerdes": "Honnan származnak a gipszkarton árai?",
      "valasz": "10 magyar kereskedő nyilvános, bruttó árából (Buildox, Tüzépwebshop, Kőházy Festékáruházak, OBI), 2026. szeptember 24-i állapot szerint. A források listája linkekkel az oldal alján található."
    },
    {
      "kerdes": "Mitől függ a gipszkarton ára?",
      "valasz": "Normál 12,5 mm-es lap 2 150–2 650 Ft, impregnált (zöld) 3 590–4 110 Ft, tűzgátló ~3 550–3 600 Ft."
    },
    {
      "kerdes": "Változnak az árak városonként?",
      "valasz": "A kereskedők listaárai országosan hasonlóak, a különbséget főleg a szállítási díj és a helyi telepek árazása adja. A városi oldalakon szereplő értékek az országos átlagból, a regionális árszinttel becsült helyi árak."
    },
    {
      "kerdes": "Mire figyelj gipszkarton vásárlásakor?",
      "valasz": "Kérj írásos ajánlatot legalább 3 helyről, és kérdezz rá a szállítási díjra, a raklapdíjra és arra, hogy az ár bruttó vagy nettó. Nagyobb tételnél a tüzépek gyakran adnak kedvezményt."
    }
  ],
