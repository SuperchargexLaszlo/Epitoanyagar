  "faq": [
    {
      "kerdes": "Mennyibe kerül a szögvas 2026-ban?",
      "valasz": "Szögvas ára 2026 szeptemberében 570–1 960 Ft/fm, a boltok átlagára 1 100 Ft/fm (bruttó, szállítás nélkül). A vizsgált változatok közül a legolcsóbb: Szögacél L 30x30x3 (785 Ft), a legdrágább: Szögacél L 50x50x5 (1 960 Ft)."
    },
    {
      "kerdes": "Honnan származnak a szögvas árai?",
      "valasz": "5 magyar kereskedő nyilvános, bruttó árából (Tolnay Vasker, Tímár Vasker, KLS Design, LMNT), 2026. szeptember 24-i állapot szerint. A források listája linkekkel az oldal alján található."
    },
    {
      "kerdes": "Mitől függ a szögvas ára?",
      "valasz": "Melegen hengerelt, egyenlő szárú L-acél, 6 m-es szálban."
    },
    {
      "kerdes": "Változnak az árak városonként?",
      "valasz": "A kereskedők listaárai országosan hasonlóak, a különbséget főleg a szállítási díj és a helyi telepek árazása adja. A városi oldalakon szereplő értékek az országos átlagból, a regionális árszinttel becsült helyi árak."
    },
    {
      "kerdes": "Mire figyelj szögvas vásárlásakor?",
      "valasz": "Kérj írásos ajánlatot legalább 3 helyről, és kérdezz rá a szállítási díjra, a raklapdíjra és arra, hogy az ár bruttó vagy nettó. Nagyobb tételnél a tüzépek gyakran adnak kedvezményt."
    }
  ],
