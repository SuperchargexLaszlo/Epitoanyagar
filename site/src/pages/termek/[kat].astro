---
/**
 * Merkury termékkategória-oldalak: /termek/[kat]/
 * Csak azok a csoportok kapnak önálló oldalt, amikhez NINCS meglévő
 * /[anyag]-ara/ oldal — azokra a termékek közvetlenül az anyag-oldalra kerülnek.
 */
import fs from 'fs';
import path from 'path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MerkuryProducts from '../../components/MerkuryProducts.astro';
import { SITE, huf } from '../../lib/format';

export async function getStaticPaths() {
  const p = path.resolve('..', 'data', 'merkury.json');
  const csoportok = JSON.parse(fs.readFileSync(p, 'utf-8'));
  return csoportok
    .filter((c: any) => !c.anyag && c.termekek.length > 0)
    .map((c: any) => ({ params: { kat: c.slug }, props: { csoport: c, csoportok } }));
}

const { csoport, csoportok } = Astro.props;
const canonicalURL = `${SITE}/termek/${csoport.slug}/`;
const t = csoport.termekek;
const minAr = t[0].ar;
const maxAr = t[t.length - 1].ar;
const median = t[Math.floor(t.length / 2)].ar;

const title = `${csoport.nev} ár 2026: ${huf(minAr)}–${huf(maxAr)} Ft | Árlista`;
const description = `${csoport.nev} árak 2026-ban: ${huf(minAr)} Ft-tól, tipikus ár ${huf(median)} Ft. ${huf(csoport.osszes)} termék kínálatából válogatva, márkákkal és képekkel.`;

const tobbiek = csoportok.filter((c: any) => !c.anyag && c.slug !== csoport.slug && c.termekek.length > 0);
const anyagosak = csoportok.filter((c: any) => c.anyag && c.termekek.length > 0);

// A Breadcrumb komponens SAJAT BreadcrumbList schemat ad ki, ezert itt csak
// az ItemList szerepel - kulonben ket BreadcrumbList lenne az oldalon.
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: csoport.nev,
  numberOfItems: t.length,
  itemListElement: t.slice(0, 20).map((p: any, i: number) => ({
    '@type': 'ListItem', position: i + 1, name: p.nev,
  })),
});
---
<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={schema}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { label: 'Főoldal', href: '/' },
      { label: 'Termékek', href: '/termek/' },
      { label: csoport.nev, href: `/termek/${csoport.slug}/` },
    ]} />

    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mt-4">{csoport.nev} ára 2026</h1>
    <p class="text-lg text-gray-600 mt-3">
      A(z) {csoport.nev.toLowerCase()} ára jelenleg <b>{huf(minAr)} Ft</b> és <b>{huf(maxAr)} Ft</b> között mozog,
      a tipikus ár <b>{huf(median)} Ft</b> körül van.
    </p>

    <div class="grid grid-cols-3 gap-3 my-6">
      <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
        <div class="text-xs text-gray-500 uppercase tracking-wide">Legolcsóbb</div>
        <div class="text-xl font-bold text-green-700 mt-1">{huf(minAr)} Ft</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
        <div class="text-xs text-gray-500 uppercase tracking-wide">Tipikus ár</div>
        <div class="text-xl font-bold text-blue-700 mt-1">{huf(median)} Ft</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
        <div class="text-xs text-gray-500 uppercase tracking-wide">Legdrágább</div>
        <div class="text-xl font-bold text-gray-700 mt-1">{huf(maxAr)} Ft</div>
      </div>
    </div>

    <div class="bg-blue-50 border border-blue-200 rounded-lg p-5 my-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-2">Miből adódik az árkülönbség?</h2>
      <p class="text-gray-700 text-sm leading-relaxed">
        Egy {csoport.nev.toLowerCase()} esetében az ár szélső értékei között
        <b> {Math.round(maxAr / minAr)}-szeres</b> a különbség. Ez ritkán a minőség önmagában:
        jellemzően a méret, az anyag, a felület (króm, matt fekete, arany) és a márka együtt mozgatja.
        Felújításnál érdemes a tipikus ár körül keresni — a legolcsóbb sáv gyakran kisebb méret vagy
        egyszerűbb kivitel, a legfelső sáv pedig design-felár.
      </p>
    </div>

    <MerkuryProducts
      termekek={t}
      cim={`${csoport.nev} — aktuális ajánlatok`}
      bevezeto="Ár szerint növekvő sorrendben, a MerkuryMarket kínálatából."
      template="attribute/long-tail"
      pagePath={`/termek/${csoport.slug}/`}
      osszes={csoport.osszes}
    />

    <section class="my-10">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">További termékkategóriák</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {tobbiek.map((c: any) => (
          <a href={`/termek/${c.slug}/`} class="bg-white border border-gray-200 rounded-lg p-3 hover:border-blue-500 hover:shadow-sm transition-all">
            <div class="font-semibold text-gray-900 text-sm">{c.nev}</div>
            <div class="text-xs text-gray-500 mt-1">{huf(c.minAr)} Ft-tól · {huf(c.osszes)} termék</div>
          </a>
        ))}
      </div>
    </section>

    {anyagosak.length > 0 && (
      <section class="my-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Építőanyag árak</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {anyagosak.map((c: any) => (
            <a href={`/${c.anyag}-ara/`} class="bg-white border border-gray-200 rounded-lg p-3 hover:border-blue-500 hover:shadow-sm transition-all">
              <div class="font-semibold text-gray-900 text-sm">{c.nev}</div>
              <div class="text-xs text-gray-500 mt-1">árak és termékek</div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
