---
/** Merkury termékkategóriák gyűjtőoldala: /termek/ */
import fs from 'fs';
import path from 'path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE, huf } from '../../lib/format';

const csoportok = JSON.parse(
  fs.readFileSync(path.resolve('..', 'data', 'merkury.json'), 'utf-8'),
).filter((c: any) => c.termekek.length > 0);

const onalloak = csoportok.filter((c: any) => !c.anyag);
const anyagosak = csoportok.filter((c: any) => c.anyag);
const osszTermek = csoportok.reduce((n: number, c: any) => n + c.osszes, 0);

const canonicalURL = `${SITE}/termek/`;
const title = 'Felújítási termékek árai 2026 – csaptelep, csempe, ajtó, padló';
const description = `Felújítási és befejező termékek aktuális árai: csaptelep, zuhanykabin, beltéri ajtó, csempe, padló, konyhai mosogató. ${huf(osszTermek)} termék kínálatából, képekkel és árakkal.`;

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Felújítási termékek árai',
  url: canonicalURL,
  inLanguage: 'hu',
  description,
});
---
<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={schema}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumb items={[{ label: 'Főoldal', href: '/' }, { label: 'Termékek', href: '/termek/' }]} />

    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mt-4">Felújítási termékek árai</h1>
    <p class="text-lg text-gray-600 mt-3 max-w-3xl">
      Az építőanyag-árak mellett itt a <b>befejező és felújítási termékek</b> aktuális árai találhatók —
      csaptelep, zuhanykabin, beltéri ajtó, konyhai mosogató, burkolat. Minden ár valós termékkínálatból,
      nem becslésből.
    </p>

    <section class="my-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Termékkategóriák</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {onalloak.map((c: any) => (
          <a href={`/termek/${c.slug}/`} class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-500 hover:shadow-sm transition-all">
            <div class="font-semibold text-gray-900">{c.nev}</div>
            <div class="text-sm text-green-700 font-medium mt-1">{huf(c.minAr)} Ft-tól</div>
            <div class="text-xs text-gray-500 mt-0.5">{huf(c.osszes)} termék</div>
          </a>
        ))}
      </div>
    </section>

    <section class="my-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Burkolatok — az anyagár-oldalakon</h2>
      <p class="text-gray-600 text-sm mb-4">
        Ezeknél a termékeknél az árlista és a megvásárolható termékek egy oldalon vannak.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {anyagosak.map((c: any) => (
          <a href={`/${c.anyag}-ara/`} class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-500 hover:shadow-sm transition-all">
            <div class="font-semibold text-gray-900">{c.nev}</div>
            <div class="text-sm text-green-700 font-medium mt-1">{huf(c.minAr)} Ft-tól</div>
            <div class="text-xs text-gray-500 mt-0.5">{huf(c.osszes)} termék</div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
