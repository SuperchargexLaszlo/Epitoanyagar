---
import fs from 'fs';
import path from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { SITE, huf, datumHosszu, rovidEgyseg } from '../lib/format';

const dataDir = path.resolve('..', 'data');
const st = JSON.parse(fs.readFileSync(path.join(dataDir, 'statisztika.json'), 'utf-8'));
const anyagok = JSON.parse(fs.readFileSync(path.join(dataDir, 'anyagok.json'), 'utf-8'));

const canonicalURL = `${SITE}/epitoanyag-arak-alakulasa/`;
const frissitve = st.frissitve;

// Szám formázása tizedesvesszővel, előjellel
const pct = (n: number, jel = true) => `${jel && n > 0 ? '+' : ''}${n.toFixed(1).replace('.', ',')}%`;
const idx = (n: number) => n.toFixed(1).replace('.', ',');

const szint = st.anyagkoltseg_szint_2015.adatok;
const sz2019 = szint.find((d: any) => d.ev === '2019');
const sz2025 = szint.find((d: any) => d.ev === '2025');
const szorzo2019 = sz2025.anyag / sz2019.anyag; // ~2,0
const negyed = st.negyedeves_anyag.adatok;
const utolsoNegyed = negyed[negyed.length - 1];
const tegla = st.szakagazatok.adatok[0];
const cement = st.szakagazatok.adatok[3];
const fogy = st.fogyasztoi_04_3_1.havi_2026;
const fogyUtolso = fogy[fogy.length - 1];
const t26 = st.termelo_2026;
const fk = st.fajlagos_koltseg.adatok;

// --- 1. ábra: anyag- és munkaerőköltség szintje (2015 = 100), csoportosított oszlop ---
const c1 = { w: 720, h: 300, pl: 44, pr: 12, pt: 16, pb: 30 };
const c1max = 300;
const c1innerW = c1.w - c1.pl - c1.pr;
const c1innerH = c1.h - c1.pt - c1.pb;
const c1slot = c1innerW / szint.length;
const c1bar = Math.min(18, c1slot / 2 - 3);
const c1y = (v: number) => c1.pt + c1innerH - (v / c1max) * c1innerH;
const c1grid = [0, 100, 200, 300];

// --- 2. ábra: anyagköltség negyedéves változása (%), pozitív/negatív oszlop ---
const c2 = { w: 720, h: 260, pl: 40, pr: 12, pt: 14, pb: 44 };
const c2min = -5, c2max = 30;
const c2innerW = c2.w - c2.pl - c2.pr;
const c2innerH = c2.h - c2.pt - c2.pb;
const c2slot = c2innerW / negyed.length;
const c2bar = Math.min(22, c2slot - 6);
const c2y = (v: number) => c2.pt + ((c2max - v) / (c2max - c2min)) * c2innerH;
const c2grid = [-5, 0, 10, 20, 30];

// --- Aktuális bolti árak a legkeresettebb anyagokra ---
const kiemelt = ['cement', 'beton', 'soder', 'zuzott-ko', 'betonacél', 'tegla', 'poroton', 'ytong', 'zsaluko', 'osb-lap', 'gipszkarton', 'kozetgyapot', 'eps', 'terko', 'zartszelveny', 'trapezlemez'];
const arTabla = kiemelt.map((slug) => {
  const a = anyagok.find((x: any) => x.slug === slug);
  const d = JSON.parse(fs.readFileSync(path.join(dataDir, 'arak', `${slug}.json`), 'utf-8'));
  return { slug, nev: a.nev, min: d.alap_ar.min, max: d.alap_ar.max, atlag: d.alap_ar.atlag, egyseg: d.alap_ar.egyseg, forrasDb: (d.forrasok || []).length };
});

const title = 'Építőanyag árak alakulása 2026 – KSH-adatok, drágulás, bolti árak';
const description = `Hogyan változtak az építőanyag-árak 2026-ban? KSH: lakásépítés anyagköltsége ${pct(utolsoNegyed.anyag)} (2026 I. n.év), tégla és cserép ${pct(tegla.jul2026)} (július). 2019 óta kétszeres szint. Bolti árak ${datumHosszu(frissitve)}.`;

const faq = [
  {
    kerdes: 'Mennyivel drágultak az építőanyagok 2026-ban?',
    valasz: `A KSH szerint a lakásépítés anyagköltsége 2026 I. negyedévében ${pct(utolsoNegyed.anyag)} volt egy évvel korábbihoz képest. A lakásjavítási anyagok fogyasztói ára 2026 augusztusában ${pct(fogyUtolso.ertek)}. Anyagonként nagy a különbség: a tégla és cserép termelői ára júliusban ${pct(tegla.jul2026)}, a cementé ${pct(cement.jul2026)}.`,
  },
  {
    kerdes: 'Mennyivel drágább ma építkezni, mint 2019-ben?',
    valasz: `A lakásépítés anyagköltség-indexe 2019-ben ${idx(sz2019.anyag)}, 2025-ben ${idx(sz2025.anyag)} volt (2015 = 100), vagyis az anyagok ára kb. ${szorzo2019.toFixed(1).replace('.', ',')}-szeresére nőtt. A munkaerőköltség ugyanebben az időszakban ${idx(sz2019.munkaero)}-ról ${idx(sz2025.munkaero)}-ra emelkedett.`,
  },
  {
    kerdes: 'Melyik építőanyag drágult a legjobban 2026-ban?',
    valasz: `A KSH szakágazati adatai szerint a tégla, cserép és kerámia építőanyagok: termelői áruk 2025 decembere óta ${pct(tegla.dec2025ota)}, egy év alatt ${pct(tegla.jul2026)}. Az emelés 2026 májusában és júniusában jelent meg. A cement, mész és gipsz termelői ára gyakorlatilag nem változott.`,
  },
  {
    kerdes: 'Várható további drágulás 2026 végéig?',
    valasz: `Hivatalos, építőanyagra vonatkozó előrejelzés nincs. A kereslet gyenge: az építőipari termelés 2026 júliusában ${pct(t26.termeles_2026_jul)}, az új szerződések ${pct(t26.uj_szerzodesek_2026_jul)} voltak egy évvel korábbihoz képest, ami a nagyobb áremeléseket fékezi. A következő KSH-adat (lakásépítési költségindex, 2026 II. negyedév) 2026. szeptember 29-én jelenik meg.`,
  },
  {
    kerdes: 'Mennyibe kerül 1 m² családi ház felépítése?',
    valasz: `A KSH fajlagos lakásépítési költsége új családi házra 2025-ben ${fk[fk.length - 1].ertek} ezer Ft/m² volt (anyag és munkadíj együtt, telek nélkül), 2021-ben még ${fk[1].ertek} ezer Ft/m².`,
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Építőanyag árak alakulása 2026',
  datePublished: '2026-09-24',
  dateModified: frissitve,
  author: { '@type': 'Organization', name: 'epitoanyagar.hu' },
  publisher: { '@type': 'Organization', name: 'Építőanyag ár', url: SITE },
  url: canonicalURL,
  description,
  citation: [st.anyagkoltseg_szint_2015.url, st.negyedeves_anyag.url, st.szakagazatok.url, st.fogyasztoi_04_3_1.url],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.kerdes, acceptedAnswer: { '@type': 'Answer', text: f.valasz } })),
};
const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Magyarországi építőanyag-árak és építési költségindexek 2015–2026',
  description: 'KSH lakásépítési költségindex, építőipari termelői árindex, szakágazati termelői árak és 2026. szeptemberi bolti építőanyag-árak.',
  url: canonicalURL,
  temporalCoverage: '2015/2026',
  spatialCoverage: 'Magyarország',
  creator: { '@type': 'Organization', name: 'epitoanyagar.hu' },
  isBasedOn: 'https://www.ksh.hu/',
};
const schema = JSON.stringify([articleSchema, faqSchema, datasetSchema]);
---
<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={schema}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { label: 'Főoldal', href: '/' },
      { label: 'Építőanyag árak alakulása 2026', href: '/epitoanyag-arak-alakulasa/' },
    ]} />

    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">Építőanyag árak alakulása 2026</h1>
    <p class="text-sm text-gray-500 mb-6">
      Frissítve: <time datetime={frissitve}>{datumHosszu(frissitve)}</time> · Források: KSH, 2026. szeptemberi bolti árak
    </p>

    <p class="text-gray-700 leading-relaxed mb-4">
      Ez az oldal a KSH építőipari ár- és költségstatisztikáit és a boltokban most fizetendő árakat foglalja össze.
      Röviden: az építőanyagok 2026-ban mérsékelten drágulnak, a mutatótól függően 2–7%-kal egy év alatt.
      Kivétel a tégla és a cserép, ahol a gyártói árak május–júniusban 7–8%-kal emelkedtek.
      Hosszabb távon az anyagköltség 2019 óta nagyjából a kétszeresére nőtt.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-6">
      <div class="bg-white border border-gray-200 rounded-xl p-4">
        <div class="text-2xl font-bold text-gray-900">{pct(utolsoNegyed.anyag)}</div>
        <div class="text-xs text-gray-600 mt-1">lakásépítés anyagköltsége, 2026 I. n.év, egy év alatt</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4">
        <div class="text-2xl font-bold text-red-700">{pct(tegla.jul2026)}</div>
        <div class="text-xs text-gray-600 mt-1">tégla, cserép gyártói ára, 2026 július, egy év alatt</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4">
        <div class="text-2xl font-bold text-gray-900">{pct(cement.jul2026)}</div>
        <div class="text-xs text-gray-600 mt-1">cement, mész, gipsz gyártói ára, 2026 július</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4">
        <div class="text-2xl font-bold text-gray-900">{szorzo2019.toFixed(1).replace('.', ',')}×</div>
        <div class="text-xs text-gray-600 mt-1">anyagköltség 2025-ben a 2019-es szinthez képest</div>
      </div>
    </div>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Mi történt 2026-ban?</h2>
    <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-4">
      <li>
        <strong>Január–február:</strong> a lakásjavítási anyagok fogyasztói ára januárban {pct(fogy[0].ertek)}, februárban {pct(fogy[1].ertek)} volt egy évvel korábbihoz képest. A cement gyártói ára januárban 1,5%-kal emelkedett, a tégláé nem változott.
      </li>
      <li>
        <strong>Március:</strong> a közel-keleti háború miatt megugrottak az energiaárak. A gyártók és kereskedők áprilistól 5–15%-os drágulást jeleztek (<a class="text-blue-600 hover:underline" href={st.hirek[0].url} rel="nofollow noopener" target="_blank">Economx</a>), egyes becslések 10–25%-ot is említettek (<a class="text-blue-600 hover:underline" href={st.hirek[1].url} rel="nofollow noopener" target="_blank">Portfolio</a>).
      </li>
      <li>
        <strong>Május–június:</strong> a téglagyártók emelése megjelent a KSH-adatokban: a kerámia építőanyagok termelői ára májusban 3,9%-kal, júniusban 3,5%-kal nőtt az előző hónaphoz képest. Az ÉVOSZ építőanyag-kereskedelmi tagozata szerint falazóanyagoknál és tégláknál 10–15%-os emelést jelentettek be a nagy gyártók (<a class="text-blue-600 hover:underline" href={st.hirek[2].url} rel="nofollow noopener" target="_blank">Index</a>).
      </li>
      <li>
        <strong>Első félév összesen:</strong> a kereskedői tagozat szerint az építőanyag-árak átlagosan 2,7%-kal nőttek, mert az erősödő forint tompította az energiaár hatását (<a class="text-blue-600 hover:underline" href={st.hirek[3].url} rel="nofollow noopener" target="_blank">Privátbankár</a>).
      </li>
      <li>
        <strong>Július–augusztus:</strong> az építőipari termelés júliusban {pct(Math.abs(t26.termeles_2026_jul), false)}-kal, az új szerződések volumene {pct(Math.abs(t26.uj_szerzodesek_2026_jul), false)}-kal volt kisebb egy évvel korábbinál (<a class="text-blue-600 hover:underline" href={t26.termeles_url} rel="nofollow noopener" target="_blank">KSH</a>). A lakásjavítási anyagok fogyasztói ára augusztusban {pct(fogyUtolso.ertek)}.
      </li>
    </ul>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Anyag- és munkaerőköltség 2015–2025</h2>
    <p class="text-gray-700 leading-relaxed mb-3">
      A KSH lakásépítési költségindexe két részre bontja az építés költségét. Az anyagköltség 2021–2022-ben nőtt a leggyorsabban (évi 21 és 24%), 2024-ben szinte megállt (+0,9%), 2025-ben ismét {pct(st.eves_valtozas.adatok[6].anyag)}-kal emelkedett.
      A munkadíjak 2023 óta gyorsabban nőnek, mint az anyagárak.
    </p>
    <figure class="bg-white border border-gray-200 rounded-xl p-3 sm:p-4 my-4">
      <svg viewBox={`0 0 ${c1.w} ${c1.h}`} class="w-full h-auto" role="img" aria-label="Oszlopdiagram: lakásépítés anyag- és munkaerőköltség-indexe 2015–2025, 2015 = 100">
        {c1grid.map((g) => (
          <g>
            <line x1={c1.pl} x2={c1.w - c1.pr} y1={c1y(g)} y2={c1y(g)} stroke="#e5e7eb" stroke-width="1" />
            <text x={c1.pl - 6} y={c1y(g) + 4} text-anchor="end" font-size="11" fill="#6b7280">{g}</text>
          </g>
        ))}
        {szint.map((d: any, i: number) => {
          const x0 = c1.pl + i * c1slot + c1slot / 2;
          return (
            <g>
              <rect x={x0 - c1bar - 1} y={c1y(d.anyag)} width={c1bar} height={c1y(0) - c1y(d.anyag)} fill="#2563eb" rx="2">
                <title>{d.ev} anyagköltség: {idx(d.anyag)}</title>
              </rect>
              <rect x={x0 + 1} y={c1y(d.munkaero)} width={c1bar} height={c1y(0) - c1y(d.munkaero)} fill="#f59e0b" rx="2">
                <title>{d.ev} munkaerőköltség: {idx(d.munkaero)}</title>
              </rect>
              <text x={x0} y={c1.h - 10} text-anchor="middle" font-size="11" fill="#374151">{d.ev}</text>
            </g>
          );
        })}
        <text x={c1.pl + c1slot * 10 + c1slot / 2 - c1bar / 2 - 1} y={c1y(sz2025.anyag) - 5} text-anchor="middle" font-size="11" font-weight="600" fill="#1d4ed8">{idx(sz2025.anyag)}</text>
        <text x={c1.pl + c1slot * 10 + c1slot / 2 + c1bar / 2 + 1} y={c1y(sz2025.munkaero) - 5} text-anchor="middle" font-size="11" font-weight="600" fill="#b45309">{idx(sz2025.munkaero)}</text>
      </svg>
      <figcaption class="flex flex-wrap gap-4 text-xs text-gray-600 mt-2 px-1">
        <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm bg-blue-600"></span>Anyagköltség</span>
        <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm bg-amber-500"></span>Munkaerőköltség</span>
        <span>2015 = 100 · Forrás: <a class="text-blue-600 hover:underline" href={st.anyagkoltseg_szint_2015.url} rel="nofollow noopener" target="_blank">KSH 18.1.1.11</a></span>
      </figcaption>
    </figure>

    <div class="overflow-x-auto my-6">
      <table class="min-w-full bg-white border border-gray-200 rounded-lg text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-3 py-2 text-left font-semibold text-gray-700">Év</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">Anyagköltség</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">Munkaerőköltség</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">Lakásépítés összesen</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">Építőipari árak</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {st.eves_valtozas.adatok.map((d: any) => (
            <tr>
              <td class="px-3 py-2 text-gray-800">{d.ev}</td>
              <td class="px-3 py-2 text-right font-semibold text-gray-900">{pct(d.anyag)}</td>
              <td class="px-3 py-2 text-right text-gray-700">{pct(d.munkaero)}</td>
              <td class="px-3 py-2 text-right text-gray-700">{pct(d.osszes)}</td>
              <td class="px-3 py-2 text-right text-gray-700">{pct(d.epitoipari_ar)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="text-xs text-gray-500 mt-2">Változás az előző évhez képest. Az „építőipari árak” a kivitelezők által felszámított árak (KSH építőipari termelői árindex, 1.1.1.31).</p>
    </div>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Negyedéves változás 2021–2026</h2>
    <p class="text-gray-700 leading-relaxed mb-3">
      Az anyagköltség éves növekedése 2022 III. negyedévében tetőzött ({pct(26.6)}), 2024 első felében enyhén csökkent, azóta 5–7% körül mozog.
      A legfrissebb adat 2026 I. negyedévére {pct(utolsoNegyed.anyag)}. A II. negyedév adatát a KSH 2026. szeptember 29-én közli.
    </p>
    <figure class="bg-white border border-gray-200 rounded-xl p-3 sm:p-4 my-4">
      <svg viewBox={`0 0 ${c2.w} ${c2.h}`} class="w-full h-auto" role="img" aria-label="Oszlopdiagram: lakásépítés anyagköltségének változása az előző év azonos negyedévéhez, 2021–2026">
        {c2grid.map((g) => (
          <g>
            <line x1={c2.pl} x2={c2.w - c2.pr} y1={c2y(g)} y2={c2y(g)} stroke={g === 0 ? '#9ca3af' : '#e5e7eb'} stroke-width="1" />
            <text x={c2.pl - 6} y={c2y(g) + 4} text-anchor="end" font-size="11" fill="#6b7280">{g}%</text>
          </g>
        ))}
        {negyed.map((d: any, i: number) => {
          const x0 = c2.pl + i * c2slot + (c2slot - c2bar) / 2;
          const y = d.anyag >= 0 ? c2y(d.anyag) : c2y(0);
          const h = Math.abs(c2y(d.anyag) - c2y(0));
          const utolso = i === negyed.length - 1;
          return (
            <g>
              <rect x={x0} y={y} width={c2bar} height={h} fill={d.anyag < 0 ? '#16a34a' : utolso ? '#1d4ed8' : '#60a5fa'} rx="2">
                <title>{d.n} n.év: {pct(d.anyag)}</title>
              </rect>
              {(d.n.endsWith(' I.') || utolso) && (
                <text x={x0 + c2bar / 2} y={c2.h - 26} text-anchor="middle" font-size="11" fill="#374151">{d.n.split(' ')[0]}</text>
              )}
              {utolso && <text x={x0 + c2bar / 2} y={y - 5} text-anchor="middle" font-size="11" font-weight="600" fill="#1d4ed8">{pct(d.anyag)}</text>}
            </g>
          );
        })}
        <text x={c2.pl} y={c2.h - 6} font-size="10" fill="#6b7280">Az évszám az adott év I. negyedévénél áll.</text>
      </svg>
      <figcaption class="text-xs text-gray-600 mt-2 px-1">
        Lakásépítés anyagköltsége, változás az előző év azonos negyedévéhez · Forrás: <a class="text-blue-600 hover:underline" href={st.negyedeves_anyag.url} rel="nofollow noopener" target="_blank">KSH 18.2.1.7</a>
      </figcaption>
    </figure>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Melyik anyag drágult és melyik nem?</h2>
    <p class="text-gray-700 leading-relaxed mb-3">
      A gyártók belföldi értékesítési árai (termelői árak) anyagcsoportonként mást mutatnak. A bolti ár ezt néhány hetes késéssel követi.
    </p>
    <div class="overflow-x-auto my-4">
      <table class="min-w-full bg-white border border-gray-200 rounded-lg text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-3 py-2 text-left font-semibold text-gray-700">Anyagcsoport</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">2023</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">2024</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">2025</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">2026. júl., egy év alatt</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {st.szakagazatok.adatok.map((d: any) => (
            <tr>
              <td class="px-3 py-2 text-gray-800">{d.nev}</td>
              <td class="px-3 py-2 text-right text-gray-700">{pct(d.e2023)}</td>
              <td class="px-3 py-2 text-right text-gray-700">{pct(d.e2024)}</td>
              <td class="px-3 py-2 text-right text-gray-700">{pct(d.e2025)}</td>
              <td class={`px-3 py-2 text-right font-semibold ${d.jul2026 >= 5 ? 'text-red-700' : 'text-gray-900'}`}>{pct(d.jul2026)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="text-xs text-gray-500 mt-2">
        Éves átlagok változása az előző évhez képest. A KSH havi, előző hónap = 100 indexeiből láncolással számoltuk, a KSH által közölt decemberi értékekkel ellenőrizve (eltérés legfeljebb 0,2 pont). Forrás: <a class="text-blue-600 hover:underline" href={st.szakagazatok.url} rel="nofollow noopener" target="_blank">KSH 1.2.1.23</a>. A vas- és acélgyártás adatait a KSH 2025–2026-ban nem közli.
      </p>
    </div>
    <ul class="list-disc pl-6 space-y-1 text-gray-700 mb-4">
      <li><strong>Tégla, cserép:</strong> 2024–2025-ben nem drágult, 2026 május–júniusban egyszerre emelkedett. A Porotherm, B30 és kisméretű tégla ma 2025-höz képest érezhetően drágább.</li>
      <li><strong>Cement:</strong> a gyártói ár egy év alatt csökkent. A 25 kg-os zsák a tüzépeken 2 000–2 750 Ft.</li>
      <li><strong>Betontermékek</strong> (zsalukő, térkő, betonelemek): évi 3–4% körüli emelkedés.</li>
      <li><strong>Fa és faanyag</strong> (OSB, deszka, gerenda): 2024-es csökkenés után 2025-től enyhe emelkedés.</li>
    </ul>

