---
import fs from 'fs';
import path from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { SITE, huf, datumHosszu, honapEv } from '../lib/format';

const dataDir = path.resolve('..', 'data');
const st = JSON.parse(fs.readFileSync(path.join(dataDir, 'statisztika.json'), 'utf-8'));
const anyagok = JSON.parse(fs.readFileSync(path.join(dataDir, 'anyagok.json'), 'utf-8'));

const canonicalURL = `${SITE}/epitoanyag-arak-alakulasa/`;
const frissitve = st.frissitve;

// Szám formázása tizedesvesszővel, előjellel
const pct = (n: number, jel = true) => `${jel && n > 0 ? '+' : ''}${n.toFixed(1).replace('.', ',')}%`;
const idx = (n: number) => n.toFixed(1).replace('.', ',');

// A statisztika.json-t a scraper/ksh_update.py tölti fel (GitHub Action, KSH STADAT).
// Minden időszak-megnevezés az adatból jön, így új KSH-közlés után a szöveg is helyes marad.
const HONAP_BAN: Record<string, string> = {
  január: 'januárban', február: 'februárban', március: 'márciusban', április: 'áprilisban', május: 'májusban', június: 'júniusban',
  július: 'júliusban', augusztus: 'augusztusban', szeptember: 'szeptemberben', október: 'októberben', november: 'novemberben', december: 'decemberben',
};
// "2026. július" -> "2026. júliusban"
// Évszám + -ban/-ben ("2026-ban", "2025-ben")
const evBan = (ev: string | number) => {
  const n = Number(String(ev).slice(0, 4));
  const d = n % 10, t = Math.floor(n / 10) % 10;
  const magas = d === 0 ? [1, 4, 5, 7, 9].includes(t) : [1, 2, 4, 5, 7, 9].includes(d);
  return `${n}-${magas ? 'ben' : 'ban'}`;
};
const honapBan = (cimke: string) => cimke.replace(/(\p{L}+)$/u, (h) => HONAP_BAN[h] || h);

const szint = st.anyagkoltseg_szint_2015.adatok;
const sz2019 = szint.find((d: any) => d.ev === '2019');
const szU = szint[szint.length - 1];
const szorzo2019 = szU.anyag / sz2019.anyag;
const eves = st.eves_valtozas.adatok;
const evesU = eves[eves.length - 1];
const negyed = st.negyedeves_anyag.adatok;
const utolsoNegyed = negyed[negyed.length - 1];
const csucs = negyed.reduce((a: any, b: any) => (b.anyag > a.anyag ? b : a));
const sz = st.szakagazatok;
const csoportok = sz.adatok.filter((d: any) => d.kod !== '23');
const tegla = sz.adatok.find((d: any) => d.kod === '23.3');
const cement = sz.adatok.find((d: any) => d.kod === '23.5');
const legjobban = csoportok.reduce((a: any, b: any) => (b.utolso_yoy > a.utolso_yoy ? b : a));
const legkevesbe = csoportok.reduce((a: any, b: any) => (b.utolso_yoy < a.utolso_yoy ? b : a));
const csoportNev = (d: any) => d.nev.replace(/\s*\([\d.]+\)$/, '').toLowerCase();
const fogyU = st.fogyasztoi_04_3_1.utolso;
const term = st.termelo;
const fk = st.fajlagos_koltseg.adatok;
const fkU = fk[fk.length - 1];
const fk2021 = fk.find((d: any) => d.ev === '2021') || fk[0];
const adatEv = sz.utolso_honap.slice(0, 4);

// Bolti árak gyűjtésének dátuma (a legfrissebb anyagár-fájlból)
let boltiDatum = '2026-01-01';
for (const a of anyagok) {
  try {
    const d = JSON.parse(fs.readFileSync(path.join(dataDir, 'arak', `${a.slug}.json`), 'utf-8'));
    if (d.frissitve > boltiDatum) boltiDatum = d.frissitve;
  } catch (e) { /* skip */ }
}
const boltiDatumRag = datumHosszu(boltiDatum).replace(/\.$/, '');

// --- 1. ábra: anyag- és munkaerőköltség szintje (2015 = 100), csoportosított oszlop ---
const c1 = { w: 720, h: 300, pl: 44, pr: 12, pt: 16, pb: 30 };
const c1max = Math.ceil(Math.max(...szint.map((d: any) => Math.max(d.anyag, d.munkaero))) / 50) * 50;
const c1innerW = c1.w - c1.pl - c1.pr;
const c1innerH = c1.h - c1.pt - c1.pb;
const c1slot = c1innerW / szint.length;
const c1bar = Math.min(18, c1slot / 2 - 3);
const c1y = (v: number) => c1.pt + c1innerH - (v / c1max) * c1innerH;
const c1grid = Array.from({ length: Math.floor(c1max / 100) + 1 }, (_, i) => i * 100);

// --- 2. ábra: anyagköltség negyedéves változása (%), pozitív/negatív oszlop ---
const c2 = { w: 720, h: 260, pl: 40, pr: 12, pt: 14, pb: 44 };
const c2min = Math.min(-5, Math.floor(Math.min(...negyed.map((d: any) => d.anyag)) / 5) * 5);
const c2max = Math.max(10, Math.ceil(Math.max(...negyed.map((d: any) => d.anyag)) / 10) * 10);
const c2innerW = c2.w - c2.pl - c2.pr;
const c2innerH = c2.h - c2.pt - c2.pb;
const c2slot = c2innerW / negyed.length;
const c2bar = Math.min(22, c2slot - 6);
const c2y = (v: number) => c2.pt + ((c2max - v) / (c2max - c2min)) * c2innerH;
const c2grid = [c2min, 0, ...Array.from({ length: c2max / 10 }, (_, i) => (i + 1) * 10)];

// --- Aktuális bolti árak a legkeresettebb anyagokra ---
const kiemelt = ['cement', 'beton', 'soder', 'zuzott-ko', 'betonacél', 'tegla', 'poroton', 'ytong', 'zsaluko', 'osb-lap', 'gipszkarton', 'kozetgyapot', 'eps', 'terko', 'zartszelveny', 'trapezlemez'];
const arTabla = kiemelt.map((slug) => {
  const a = anyagok.find((x: any) => x.slug === slug);
  const d = JSON.parse(fs.readFileSync(path.join(dataDir, 'arak', `${slug}.json`), 'utf-8'));
  return { slug, nev: a.nev, min: d.alap_ar.min, max: d.alap_ar.max, atlag: d.alap_ar.atlag, egyseg: d.alap_ar.egyseg, forrasDb: (d.forrasok || []).length };
});

const title = `Építőanyag árak alakulása ${adatEv} – KSH-adatok, drágulás, bolti árak`;
const description = `Hogyan változnak az építőanyag-árak ${evBan(adatEv)}? KSH: lakásépítés anyagköltsége ${pct(utolsoNegyed.anyag)} (${utolsoNegyed.n} n.év), ${csoportNev(legjobban)} ${pct(legjobban.utolso_yoy)} (${sz.utolso_honap_rovid}). Bolti árak: ${datumHosszu(boltiDatum)}.`;

const faq = [
  {
    kerdes: `Mennyivel drágultak az építőanyagok ${evBan(adatEv)}?`,
    valasz: `A KSH szerint a lakásépítés anyagköltsége ${utolsoNegyed.n} negyedévében ${pct(utolsoNegyed.anyag)} volt egy évvel korábbihoz képest. A lakásjavítási anyagok fogyasztói ára ${honapBan(fogyU.honap)} ${pct(fogyU.ertek)}. Anyagcsoportonként nagy a különbség: ${honapBan(sz.utolso_honap)} a ${csoportNev(tegla)} termelői ára ${pct(tegla.utolso_yoy)}, a ${csoportNev(cement)} termelői ára ${pct(cement.utolso_yoy)} egy év alatt.`,
  },
  {
    kerdes: 'Mennyivel drágább ma építkezni, mint 2019-ben?',
    valasz: `A lakásépítés anyagköltség-indexe 2019-ben ${idx(sz2019.anyag)}, ${evBan(szU.ev)} ${idx(szU.anyag)} volt (2015 = 100), vagyis az anyagok ára kb. ${szorzo2019.toFixed(1).replace('.', ',')}-szeresére nőtt. A munkaerőköltség ugyanebben az időszakban ${idx(sz2019.munkaero)}-ról ${idx(szU.munkaero)}-ra emelkedett.`,
  },
  {
    kerdes: `Melyik építőanyag drágult a legjobban ${evBan(adatEv)}?`,
    valasz: `A KSH szakágazati adatai szerint a ${csoportNev(legjobban)}: termelői áruk ${sz.elozo_dec} óta ${legjobban.dec_ota !== null ? pct(legjobban.dec_ota) : 'n. a.'}, egy év alatt ${pct(legjobban.utolso_yoy)} (${sz.utolso_honap}). A legkevésbé a ${csoportNev(legkevesbe)} ára változott: ${pct(legkevesbe.utolso_yoy)}.`,
  },
  {
    kerdes: 'Várható további drágulás?',
    valasz: `Hivatalos, építőanyagra vonatkozó előrejelzés nincs. A kereslet gyenge: az építőipari termelés volumene ${honapBan(term.termeles.honap)} ${pct(term.termeles.termeles)}, az új szerződéseké ${pct(term.termeles.uj_szerzodesek)} volt egy évvel korábbihoz képest, ami a nagyobb áremeléseket fékezi.`,
  },
  {
    kerdes: 'Mennyibe kerül 1 m² családi ház felépítése?',
    valasz: `A KSH fajlagos lakásépítési költsége új családi házra ${evBan(fkU.ev)} ${fkU.ertek} ezer Ft/m² volt (anyag és munkadíj együtt, telek nélkül), ${evBan(fk2021.ev)} még ${fk2021.ertek} ezer Ft/m².`,
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `Építőanyag árak alakulása ${adatEv}`,
  datePublished: '2026-09-24',
  dateModified: frissitve,
  author: { '@type': 'Organization', name: 'epitoanyagar.hu' },
  publisher: { '@type': 'Organization', name: 'Építőanyag ár', url: SITE },
  url: canonicalURL,
  description,
  citation: [st.anyagkoltseg_szint_2015.url, st.negyedeves_anyag.url, st.szakagazatok.url, st.fogyasztoi_04_3_1.url],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.kerdes, acceptedAnswer: { '@type': 'Answer', text: f.valasz } })),
};
const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Magyarországi építőanyag-árak és építési költségindexek 2015–${adatEv}`,
  description: 'KSH lakásépítési költségindex, építőipari termelői árindex, szakágazati termelői árak és aktuális bolti építőanyag-árak.',
  url: canonicalURL,
  temporalCoverage: `2015/${adatEv}`,
  spatialCoverage: 'Magyarország',
  creator: { '@type': 'Organization', name: 'epitoanyagar.hu' },
  isBasedOn: 'https://www.ksh.hu/',
};
const schema = JSON.stringify([articleSchema, faqSchema, datasetSchema]);
---
<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={schema}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { label: 'Főoldal', href: '/' },
      { label: `Építőanyag árak alakulása ${adatEv}`, href: '/epitoanyag-arak-alakulasa/' },
    ]} />

    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">Építőanyag árak alakulása {adatEv}</h1>
    <p class="text-sm text-gray-500 mb-6">
      KSH-adatok frissítve: <time datetime={frissitve}>{datumHosszu(frissitve)}</time> · Bolti árak: {datumHosszu(boltiDatum)}
    </p>

    <p class="text-gray-700 leading-relaxed mb-4">
      Ez az oldal a KSH építőipari ár- és költségstatisztikáit és a boltokban most fizetendő árakat foglalja össze.
      A legfrissebb adatok szerint a lakásépítés anyagköltsége {utolsoNegyed.n} negyedévében {pct(utolsoNegyed.anyag)}, a lakásjavítási anyagok fogyasztói ára {honapBan(fogyU.honap)} {pct(fogyU.ertek)} volt egy év alatt.
      Anyagcsoportonként nagy a különbség: {honapBan(sz.utolso_honap)} a {csoportNev(legjobban)} gyártói ára {pct(legjobban.utolso_yoy)}, a {csoportNev(legkevesbe)} ára {pct(legkevesbe.utolso_yoy)}.
      Hosszabb távon az anyagköltség {evBan(szU.ev)} a 2019-es szint {szorzo2019.toFixed(1).replace('.', ',')}-szerese volt.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-6">
      <div class="bg-white border border-gray-200 rounded-xl p-4">
        <div class="text-2xl font-bold text-gray-900">{pct(utolsoNegyed.anyag)}</div>
        <div class="text-xs text-gray-600 mt-1">lakásépítés anyagköltsége, {utolsoNegyed.n} n.év, egy év alatt</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4">
        <div class={`text-2xl font-bold ${tegla.utolso_yoy >= 5 ? 'text-red-700' : 'text-gray-900'}`}>{pct(tegla.utolso_yoy)}</div>
        <div class="text-xs text-gray-600 mt-1">tégla, cserép gyártói ára, {sz.utolso_honap_rovid}, egy év alatt</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4">
        <div class="text-2xl font-bold text-gray-900">{pct(cement.utolso_yoy)}</div>
        <div class="text-xs text-gray-600 mt-1">cement, mész, gipsz gyártói ára, {sz.utolso_honap_rovid}, egy év alatt</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4">
        <div class="text-2xl font-bold text-gray-900">{szorzo2019.toFixed(1).replace('.', ',')}×</div>
        <div class="text-xs text-gray-600 mt-1">anyagköltség {evBan(szU.ev)} a 2019-es szinthez képest</div>
      </div>
    </div>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Mi történt 2026-ban?</h2>
    <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-4">
      <li>
        <strong>Január–február:</strong> a lakásjavítási anyagok fogyasztói ára januárban +4,1%, februárban +3,8% volt egy évvel korábbihoz képest. A cement gyártói ára januárban 1,5%-kal emelkedett, a tégláé nem változott.
      </li>
      <li>
        <strong>Március:</strong> a közel-keleti háború miatt megugrottak az energiaárak. A gyártók és kereskedők áprilistól 5–15%-os drágulást jeleztek (<a class="text-blue-600 hover:underline" href={st.hirek[0].url} rel="nofollow noopener" target="_blank">Economx</a>), egyes becslések 10–25%-ot is említettek (<a class="text-blue-600 hover:underline" href={st.hirek[1].url} rel="nofollow noopener" target="_blank">Portfolio</a>).
      </li>
      <li>
        <strong>Május–június:</strong> a téglagyártók emelése megjelent a KSH-adatokban: a kerámia építőanyagok termelői ára májusban 3,9%-kal, júniusban 3,5%-kal nőtt az előző hónaphoz képest. Az ÉVOSZ építőanyag-kereskedelmi tagozata szerint falazóanyagoknál és tégláknál 10–15%-os emelést jelentettek be a nagy gyártók (<a class="text-blue-600 hover:underline" href={st.hirek[2].url} rel="nofollow noopener" target="_blank">Index</a>).
      </li>
      <li>
        <strong>Első félév összesen:</strong> a kereskedői tagozat szerint az építőanyag-árak átlagosan 2,7%-kal nőttek, mert az erősödő forint tompította az energiaár hatását (<a class="text-blue-600 hover:underline" href={st.hirek[3].url} rel="nofollow noopener" target="_blank">Privátbankár</a>).
      </li>
    </ul>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Legfrissebb KSH-adatok</h2>
    <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-4">
      <li>Lakásépítés anyagköltsége, {utolsoNegyed.n} negyedév: <strong>{pct(utolsoNegyed.anyag)}</strong>, munkaerőköltsége {pct(utolsoNegyed.munkaero)} egy év alatt (<a class="text-blue-600 hover:underline" href={st.negyedeves_anyag.url} rel="nofollow noopener" target="_blank">KSH 18.2.1.7</a>).</li>
      <li>Építőanyag-gyártók belföldi árai, {sz.utolso_honap}: {csoportok.map((d: any, i: number) => `${i ? ', ' : ''}${csoportNev(d)} ${pct(d.utolso_yoy)}`).join('')} egy év alatt (<a class="text-blue-600 hover:underline" href={sz.url} rel="nofollow noopener" target="_blank">KSH 1.2.1.23</a>).</li>
      <li>Lakásjavítási anyagok fogyasztói ára, {fogyU.honap}: <strong>{pct(fogyU.ertek)}</strong> egy év alatt (<a class="text-blue-600 hover:underline" href={st.fogyasztoi_04_3_1.url} rel="nofollow noopener" target="_blank">KSH 1.2.1.7</a>).</li>
      <li>Kivitelezői árak (építőipari termelői árindex), {term.negyed} negyedév: {pct(term.epitoipari_ar)}, ebből épületek {pct(term.epuletek)} (<a class="text-blue-600 hover:underline" href={term.url} rel="nofollow noopener" target="_blank">KSH 1.2.1.25</a>).</li>
      <li>Építőipari termelés volumene, {term.termeles.honap}: {pct(term.termeles.termeles)}, új szerződések: {pct(term.termeles.uj_szerzodesek)}; {term.termeles.kumulalt_idoszak}: {pct(term.termeles.kumulalt)} (<a class="text-blue-600 hover:underline" href={term.termeles_url} rel="nofollow noopener" target="_blank">KSH 7.2.1.1</a>).</li>
    </ul>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Anyag- és munkaerőköltség 2015–{szU.ev}</h2>
    <p class="text-gray-700 leading-relaxed mb-3">
      A KSH lakásépítési költségindexe két részre bontja az építés költségét. Az anyagköltség 2021–2022-ben nőtt a leggyorsabban (évi 21 és 24%), 2024-ben szinte megállt (+0,9%), {evBan(evesU.ev)} {pct(evesU.anyag)} volt.
      A munkadíjak 2023 óta gyorsabban nőnek, mint az anyagárak.
    </p>
    <figure class="bg-white border border-gray-200 rounded-xl p-3 sm:p-4 my-4">
      <svg viewBox={`0 0 ${c1.w} ${c1.h}`} class="w-full h-auto" role="img" aria-label="Oszlopdiagram: lakásépítés anyag- és munkaerőköltség-indexe, 2015 = 100">
        {c1grid.map((g) => (
          <g>
            <line x1={c1.pl} x2={c1.w - c1.pr} y1={c1y(g)} y2={c1y(g)} stroke="#e5e7eb" stroke-width="1" />
            <text x={c1.pl - 6} y={c1y(g) + 4} text-anchor="end" font-size="11" fill="#6b7280">{g}</text>
          </g>
        ))}
        {szint.map((d: any, i: number) => {
          const x0 = c1.pl + i * c1slot + c1slot / 2;
          return (
            <g>
              <rect x={x0 - c1bar - 1} y={c1y(d.anyag)} width={c1bar} height={c1y(0) - c1y(d.anyag)} fill="#2563eb" rx="2">
                <title>{d.ev} anyagköltség: {idx(d.anyag)}</title>
              </rect>
              <rect x={x0 + 1} y={c1y(d.munkaero)} width={c1bar} height={c1y(0) - c1y(d.munkaero)} fill="#f59e0b" rx="2">
                <title>{d.ev} munkaerőköltség: {idx(d.munkaero)}</title>
              </rect>
              <text x={x0} y={c1.h - 10} text-anchor="middle" font-size="11" fill="#374151">{d.ev}</text>
            </g>
          );
        })}
        <text x={c1.pl + c1slot * (szint.length - 1) + c1slot / 2 - c1bar / 2 - 1} y={c1y(szU.anyag) - 5} text-anchor="middle" font-size="11" font-weight="600" fill="#1d4ed8">{idx(szU.anyag)}</text>
        <text x={c1.pl + c1slot * (szint.length - 1) + c1slot / 2 + c1bar / 2 + 1} y={c1y(szU.munkaero) - 5} text-anchor="middle" font-size="11" font-weight="600" fill="#b45309">{idx(szU.munkaero)}</text>
      </svg>
      <figcaption class="flex flex-wrap gap-4 text-xs text-gray-600 mt-2 px-1">
        <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm bg-blue-600"></span>Anyagköltség</span>
        <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm bg-amber-500"></span>Munkaerőköltség</span>
        <span>2015 = 100 · Forrás: <a class="text-blue-600 hover:underline" href={st.anyagkoltseg_szint_2015.url} rel="nofollow noopener" target="_blank">KSH 18.1.1.11</a></span>
      </figcaption>
    </figure>

    <div class="overflow-x-auto my-6">
      <table class="min-w-full bg-white border border-gray-200 rounded-lg text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-3 py-2 text-left font-semibold text-gray-700">Év</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">Anyagköltség</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">Munkaerőköltség</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">Lakásépítés összesen</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">Építőipari árak</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {st.eves_valtozas.adatok.map((d: any) => (
            <tr>
              <td class="px-3 py-2 text-gray-800">{d.ev}</td>
              <td class="px-3 py-2 text-right font-semibold text-gray-900">{pct(d.anyag)}</td>
              <td class="px-3 py-2 text-right text-gray-700">{pct(d.munkaero)}</td>
              <td class="px-3 py-2 text-right text-gray-700">{pct(d.osszes)}</td>
              <td class="px-3 py-2 text-right text-gray-700">{pct(d.epitoipari_ar)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="text-xs text-gray-500 mt-2">Változás az előző évhez képest. Az „építőipari árak” a kivitelezők által felszámított árak (KSH építőipari termelői árindex, 1.1.1.31).</p>
    </div>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Negyedéves változás {negyed[0].n.slice(0, 4)}–{utolsoNegyed.n.slice(0, 4)}</h2>
    <p class="text-gray-700 leading-relaxed mb-3">
      Az anyagköltség éves növekedése {csucs.n} negyedévében tetőzött ({pct(csucs.anyag)}), 2024 első felében enyhén csökkent.
      A legfrissebb adat {utolsoNegyed.n} negyedévére {pct(utolsoNegyed.anyag)}. A KSH negyedévente, kb. három hónappal a negyedév vége után közli az újabb adatot.
    </p>
    <figure class="bg-white border border-gray-200 rounded-xl p-3 sm:p-4 my-4">
      <svg viewBox={`0 0 ${c2.w} ${c2.h}`} class="w-full h-auto" role="img" aria-label="Oszlopdiagram: lakásépítés anyagköltségének változása az előző év azonos negyedévéhez">
        {c2grid.map((g) => (
          <g>
            <line x1={c2.pl} x2={c2.w - c2.pr} y1={c2y(g)} y2={c2y(g)} stroke={g === 0 ? '#9ca3af' : '#e5e7eb'} stroke-width="1" />
            <text x={c2.pl - 6} y={c2y(g) + 4} text-anchor="end" font-size="11" fill="#6b7280">{g}%</text>
          </g>
        ))}
        {negyed.map((d: any, i: number) => {
          const x0 = c2.pl + i * c2slot + (c2slot - c2bar) / 2;
          const y = d.anyag >= 0 ? c2y(d.anyag) : c2y(0);
          const h = Math.abs(c2y(d.anyag) - c2y(0));
          const utolso = i === negyed.length - 1;
          return (
            <g>
              <rect x={x0} y={y} width={c2bar} height={h} fill={d.anyag < 0 ? '#16a34a' : utolso ? '#1d4ed8' : '#60a5fa'} rx="2">
                <title>{d.n} n.év: {pct(d.anyag)}</title>
              </rect>
              {(d.n.endsWith(' I.') || utolso) && (
                <text x={x0 + c2bar / 2} y={c2.h - 26} text-anchor="middle" font-size="11" fill="#374151">{d.n.split(' ')[0]}</text>
              )}
              {utolso && <text x={x0 + c2bar / 2} y={y - 5} text-anchor="middle" font-size="11" font-weight="600" fill="#1d4ed8">{pct(d.anyag)}</text>}
            </g>
          );
        })}
        <text x={c2.pl} y={c2.h - 6} font-size="10" fill="#6b7280">Az évszám az adott év I. negyedévénél áll.</text>
      </svg>
      <figcaption class="text-xs text-gray-600 mt-2 px-1">
        Lakásépítés anyagköltsége, változás az előző év azonos negyedévéhez · Forrás: <a class="text-blue-600 hover:underline" href={st.negyedeves_anyag.url} rel="nofollow noopener" target="_blank">KSH 18.2.1.7</a>
      </figcaption>
    </figure>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Melyik anyag drágult és melyik nem?</h2>
    <p class="text-gray-700 leading-relaxed mb-3">
      A gyártók belföldi értékesítési árai (termelői árak) anyagcsoportonként mást mutatnak. A bolti ár ezt néhány hetes késéssel követi.
    </p>
    <div class="overflow-x-auto my-4">
      <table class="min-w-full bg-white border border-gray-200 rounded-lg text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-3 py-2 text-left font-semibold text-gray-700">Anyagcsoport</th>
            {sz.evek.map((e: string) => <th class="px-3 py-2 text-right font-semibold text-gray-700">{e}</th>)}
            <th class="px-3 py-2 text-right font-semibold text-gray-700">{sz.utolso_honap_rovid}, egy év alatt</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {st.szakagazatok.adatok.map((d: any) => (
            <tr>
              <td class="px-3 py-2 text-gray-800">{d.nev}</td>
              {sz.evek.map((e: string) => <td class="px-3 py-2 text-right text-gray-700">{d.eves[e] !== undefined ? pct(d.eves[e]) : '–'}</td>)}
              <td class={`px-3 py-2 text-right font-semibold ${d.utolso_yoy >= 5 ? 'text-red-700' : 'text-gray-900'}`}>{pct(d.utolso_yoy)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="text-xs text-gray-500 mt-2">
        Éves átlagok változása az előző évhez képest. A KSH havi, előző hónap = 100 indexeiből láncolással számoltuk, a KSH által közölt, előző év decemberéhez mért értékekkel ellenőrizve. Forrás: <a class="text-blue-600 hover:underline" href={st.szakagazatok.url} rel="nofollow noopener" target="_blank">KSH 1.2.1.23</a>. A vas- és acélgyártás adatai a KSH-nál bizalmasak, ezért nem szerepelnek.
      </p>
    </div>
    <p class="text-gray-700 leading-relaxed mb-4">
      2026 tavaszán a tégla- és cserépgyártók 10–15%-os emelést jelentettek be; a KSH-adatokban ez 2026 májusában és júniusában jelent meg (+3,9% és +3,5% havonta).
      A {csoportNev(legkevesbe)} ára ugyanakkor {honapBan(sz.utolso_honap)} {pct(legkevesbe.utolso_yoy)} volt egy év alatt.
    </p>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Mennyibe kerülnek most? Bolti árak, {honapEv(boltiDatum)}</h2>
    <p class="text-gray-700 leading-relaxed mb-3">
      A KSH indexei változást mérnek, forintösszeget nem. Az alábbi árakat tüzépek, fatelepek, betonüzemek és barkácsáruházak nyilvános áraiból gyűjtöttük (gyűjtés dátuma: {datumHosszu(boltiDatum)}). Bruttó árak, szállítás nélkül.
    </p>
    <div class="overflow-x-auto my-4">
      <table class="min-w-full bg-white border border-gray-200 rounded-lg text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-3 py-2 text-left font-semibold text-gray-700">Anyag</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">Átlagár</th>
            <th class="px-3 py-2 text-right font-semibold text-gray-700">Ártartomány</th>
            <th class="px-3 py-2 text-left font-semibold text-gray-700">Egység</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {arTabla.map((r) => (
            <tr>
              <td class="px-3 py-2"><a class="text-blue-700 hover:underline" href={`/${r.slug}-ara/`}>{r.nev}</a></td>
              <td class="px-3 py-2 text-right font-semibold text-gray-900">{huf(r.atlag)} Ft</td>
              <td class="px-3 py-2 text-right text-gray-700">{huf(r.min)}–{huf(r.max)} Ft</td>
              <td class="px-3 py-2 text-gray-600">{r.egyseg.replace('Ft/', '')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Mit jelent ez egy házépítésnél?</h2>
    <p class="text-gray-700 leading-relaxed mb-3">
      A KSH becslése szerint egy új családi ház fajlagos építési költsége (anyag és munkadíj, telek nélkül) {evBan(fkU.ev)} {fkU.ertek} ezer Ft/m² volt.
      Egy 100 m²-es házra ez kb. {huf(fkU.ertek / 10)} millió Ft. A legfrissebb negyedéves ütemmel ({pct(utolsoNegyed.osszes)}, {utolsoNegyed.n} n.év) számolva egy évvel később nagyjából {huf(Math.round(fkU.ertek * (1 + utolsoNegyed.osszes / 100) / 10) * 10)} ezer Ft/m².
    </p>
    <div class="overflow-x-auto my-4">
      <table class="min-w-full bg-white border border-gray-200 rounded-lg text-sm">
        <thead class="bg-gray-50">
          <tr>
            {fk.map((d: any) => <th class="px-3 py-2 text-right font-semibold text-gray-700">{d.ev === '2020a' ? '2020' : d.ev}</th>)}
          </tr>
        </thead>
        <tbody>
          <tr>
            {fk.map((d: any) => <td class="px-3 py-2 text-right text-gray-800">{d.ertek}</td>)}
          </tr>
        </tbody>
      </table>
      <p class="text-xs text-gray-500 mt-2">Új családi ház, ezer Ft/m². {st.fajlagos_koltseg.megjegyzes} Forrás: <a class="text-blue-600 hover:underline" href={st.fajlagos_koltseg.url} rel="nofollow noopener" target="_blank">KSH 18.1.1.12</a>.</p>
    </div>

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-4">Gyakori kérdések</h2>
    <FAQ faq={faq} />

    <h2 class="text-2xl font-semibold text-gray-800 mt-10 mb-3">Források és módszertan</h2>
    <ul class="list-disc pl-6 space-y-1 text-sm text-gray-700 mb-4">
      <li><a class="text-blue-600 hover:underline" href={st.anyagkoltseg_szint_2015.url} rel="nofollow noopener" target="_blank">KSH 18.1.1.11 – A lakásépítési, munkaerő- és anyagköltség indexe (éves)</a></li>
      <li><a class="text-blue-600 hover:underline" href={st.negyedeves_anyag.url} rel="nofollow noopener" target="_blank">KSH 18.2.1.7 – A lakásépítési, munkaerő- és anyagköltség indexe negyedévenként</a></li>
      <li><a class="text-blue-600 hover:underline" href={st.fajlagos_koltseg.url} rel="nofollow noopener" target="_blank">KSH 18.1.1.12 – Fajlagos lakásépítési költség</a></li>
      <li><a class="text-blue-600 hover:underline" href="https://www.ksh.hu/stadat_files/ara/hu/ara0031.html" rel="nofollow noopener" target="_blank">KSH 1.1.1.31 – Az építőipar termelőiár-indexei</a> és <a class="text-blue-600 hover:underline" href={term.url} rel="nofollow noopener" target="_blank">1.2.1.25 (negyedéves)</a></li>
      <li><a class="text-blue-600 hover:underline" href={st.szakagazatok.url} rel="nofollow noopener" target="_blank">KSH 1.2.1.23 – Az ipar belföldi értékesítésének árindexei szakágazatonként</a></li>
      <li><a class="text-blue-600 hover:underline" href={st.fogyasztoi_04_3_1.url} rel="nofollow noopener" target="_blank">KSH 1.2.1.7 – Fogyasztóiár-index, 04.3.1 lakáskarbantartási és -javítási anyagok</a></li>
      <li><a class="text-blue-600 hover:underline" href={term.termeles_url} rel="nofollow noopener" target="_blank">KSH 7.2.1.1 – Az építőipar összefoglaló adatai, havonta</a></li>
    </ul>
    <p class="text-sm text-gray-600 leading-relaxed">
      A KSH lakásépítési költségindexe az új lakások építésének anyag- és munkaköltségét követi; felújításra, útépítésre nem vonatkozik.
      A termelői árak a gyártók belföldi eladási árai, a bolti ár ennél magasabb és később mozdul.
      A bolti árakat anyagonként legalább 3 kereskedőtől gyűjtöttük, a forráslinkek az egyes anyagoldalak alján vannak.
    </p>

    <div class="mt-10 p-4 bg-gray-50 rounded-lg border border-gray-200 text-sm">
      Anyagonkénti árlisták: <a href="/" class="text-blue-600 hover:underline font-medium">összes építőanyag ára {adatEv} →</a>
    </div>
  </div>
</BaseLayout>
