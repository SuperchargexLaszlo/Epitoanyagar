---
import fs from 'fs';
import path from 'path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE, huf, rovidEgyseg, datumHosszu, honapEv } from '../../lib/format';

export async function getStaticPaths() {
  const kategoriak = [
    { id: 'alapanyag', nev: 'Alapanyagok', leiras: 'Cement, beton, sóder, kavics, homok és egyéb alapvető építőanyagok.' },
    { id: 'falazat', nev: 'Falazati anyagok', leiras: 'Tégla, poroton, ytong, zsalukő és más falazati termékek.' },
    { id: 'teto', nev: 'Tetőfedő anyagok', leiras: 'Tetőcserép, eternit, bitumenes zsindely, tetőfólia.' },
    { id: 'szigeteles', nev: 'Szigetelő anyagok', leiras: 'Kőzetgyapot, üveggyapot, EPS, XPS és más hőszigetelések.' },
    { id: 'burkolat', nev: 'Burkolatok', leiras: 'Járólap, csempe, térkő, parkett, laminált padló.' },
    { id: 'fem', nev: 'Fém anyagok', leiras: 'Zártszelvény, szögvas, betonacél, horganyzott lemez.' },
    { id: 'lap', nev: 'Lapok és fa', leiras: 'Gipszkarton, OSB lap, rétegelt lemez, fa gerenda, deszka.' },
    { id: 'egyeb', nev: 'Egyéb anyagok', leiras: 'Vakolat, habarcs, ragasztó, vízszigetelő és egyéb kiegészítők.' },
  ];

  const dataDir = path.resolve('..', 'data');
  const anyagok = JSON.parse(fs.readFileSync(path.join(dataDir, 'anyagok.json'), 'utf-8'));

  return kategoriak.map((k) => {
    const listaz = anyagok
      .filter((a: any) => a.kategoria === k.id)
      .map((a: any) => {
        let ar = null;
        try {
          const d = JSON.parse(fs.readFileSync(path.join(dataDir, 'arak', `${a.slug}.json`), 'utf-8'));
          ar = { min: d.alap_ar.min, max: d.alap_ar.max, egyseg: rovidEgyseg(d.alap_ar.egyseg), frissitve: d.frissitve };
        } catch (e) { /* skip */ }
        return { ...a, ar };
      });
    return { params: { kat: k.id }, props: { kategoria: k, anyagok: listaz } };
  });
}

const { kategoria, anyagok } = Astro.props;
const canonicalURL = `${SITE}/kategoria/${kategoria.id}/`;
let frissitve = '2026-01-15';
for (const a of anyagok) if (a.ar?.frissitve && a.ar.frissitve > frissitve) frissitve = a.ar.frissitve;

const title = `${kategoria.nev} árak 2026 – aktuális árlista`;
const description = `Aktuális ${kategoria.nev.toLowerCase()} árak 2026-ban. ${kategoria.leiras} Naprakész árak, összehasonlítás és vásárlási tippek. Frissítve: ${honapEv(frissitve)}.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: canonicalURL,
  description,
  dateModified: frissitve,
};
---
<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={JSON.stringify(schema)}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { label: "Főoldal", href: "/" },
      { label: kategoria.nev, href: `/kategoria/${kategoria.id}/` }
    ]} />

    <h1 class="text-3xl font-bold text-gray-900 mb-2">{kategoria.nev} árak 2026</h1>
    <p class="text-sm text-gray-500 mb-4">
      Árak frissítve: <time datetime={frissitve}>{datumHosszu(frissitve)}</time>
    </p>
    <p class="text-gray-700 mb-8">{kategoria.leiras}</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {anyagok.map((a: any) => (
        <a
          href={`/${a.slug}-ara/`}
          class="flex items-center justify-between bg-white border border-gray-200 rounded-lg px-4 py-3 hover:border-blue-400 hover:shadow-sm transition-all"
        >
          <div>
            <div class="font-medium text-gray-800">{a.nev} ára 2026</div>
            {a.ar && <div class="text-xs text-gray-500">{huf(a.ar.min)} – {huf(a.ar.max)} {a.ar.egyseg}</div>}
          </div>
          <span class="text-blue-600">→</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
