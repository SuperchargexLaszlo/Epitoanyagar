---
import fs from 'fs';
import path from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceTable from '../components/PriceTable.astro';
import FAQ from '../components/FAQ.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PriceCard from '../components/PriceCard.astro';
import { SITE, huf, rovidEgyseg, datumHosszu, honapEv, termekSchema } from '../lib/format';

export async function getStaticPaths() {
  const dataDir = path.resolve('..', 'data');
  const anyagok = JSON.parse(fs.readFileSync(path.join(dataDir, 'anyagok.json'), 'utf-8'));
  const varosok = JSON.parse(fs.readFileSync(path.join(dataDir, 'varosok.json'), 'utf-8'));

  return anyagok.map((a: any) => ({
    params: { anyag: `${a.slug}-ara` },
    props: { anyag: a, varosok, anyagok }
  }));
}

const { anyag, varosok, anyagok } = Astro.props;
const dataDir = path.resolve('..', 'data');
const arFajl = path.join(dataDir, 'arak', `${anyag.slug}.json`);
const arData = JSON.parse(fs.readFileSync(arFajl, 'utf-8'));

const canonicalURL = `${SITE}/${anyag.slug}-ara/`;
const min = arData.alap_ar.min;
const max = arData.alap_ar.max;
const atlag = arData.alap_ar.atlag;
const egyseg = arData.alap_ar.egyseg;
const rEgyseg = rovidEgyseg(egyseg);
const frissitve = arData.frissitve || '2026-01-15';
const nevLower = anyag.nev.toLowerCase();

// Ár-alapú, kattintásra optimalizált cím és leírás
const title = `${anyag.nev} ára 2026: ${huf(min)}–${huf(max)} ${rEgyseg} | Árlista`;
const description = `${anyag.nev} ára 2026-ban: ${huf(min)}–${huf(max)} ${egyseg}, átlagár ${huf(atlag)} ${rEgyseg}. Friss (${honapEv(frissitve)}) árlista, variánsok és városonkénti árak 20 magyar városban.`;

const termek = termekSchema({
  nev: `${anyag.nev} – ${honapEv(frissitve)}`,
  leiras: anyag.seo_desc,
  kategoria: anyag.kategoria,
  url: canonicalURL,
  min, max, egyseg,
  ajanlatDb: arData.variansok.length,
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title.substring(0, 110),
  "datePublished": "2026-01-15",
  "dateModified": frissitve,
  "author": { "@type": "Organization", "name": "epitoanyagar.hu" },
  "publisher": { "@type": "Organization", "name": "Építőanyag ár", "url": SITE },
  "url": canonicalURL,
  "description": anyag.seo_desc
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": arData.faq.map((f: any) => ({
    "@type": "Question",
    "name": f.kerdes,
    "acceptedAnswer": { "@type": "Answer", "text": f.valasz }
  }))
};

const schema = JSON.stringify([termek, articleSchema, faqSchema]);

// Kapcsolódó anyagok – azonos kategóriából, max 6
const kapcsolodo = anyagok
  .filter((a: any) => a.kategoria === anyag.kategoria && a.slug !== anyag.slug)
  .slice(0, 6);

// Opcionális, anyag-specifikus mélytartalom
const reszletek = Array.isArray(arData.reszletek) ? arData.reszletek : [];
---
<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  schema={schema}
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { label: "Főoldal", href: "/" },
      { label: `${anyag.nev} ára 2026`, href: `/${anyag.slug}-ara/` }
    ]} />

    <h1 class="text-3xl font-bold text-gray-900 mb-2">{anyag.nev} ára 2026</h1>
    <p class="text-sm text-gray-500 mb-4">
      Árak frissítve: <time datetime={frissitve}>{datumHosszu(frissitve)}</time> · Országos árlista + 20 város
    </p>

    <p class="text-gray-700 leading-relaxed mb-6">
      A(z) <strong>{nevLower}</strong> ára 2026-ban {huf(min)} – {huf(max)} {egyseg} között mozog.
      Az átlagos piaci ár jelenleg <strong>{huf(atlag)} {egyseg}</strong>.
      {anyag.leiras}
      Az árak régiónként és minőségi kategóriánként eltérhetnek, ezért érdemes több ajánlatot kérni a vásárlás előtt.
      Oldalunkon az aktuális piaci adatok alapján naprakész tájékoztatást talál a(z) {nevLower} árairól.
    </p>

    <PriceCard
      min={min}
      max={max}
      atlag={atlag}
      egyseg={egyseg}
    />

    <h2 class="text-2xl font-semibold text-gray-800 mb-3">Aktuális {nevLower} árlista</h2>
    <PriceTable variansok={arData.variansok} egyseg={egyseg} />

    {reszletek.length > 0 && (
      <div class="mt-8 space-y-6">
        {reszletek.map((r: any) => (
          <section>
            <h2 class="text-2xl font-semibold text-gray-800 mb-3">{r.cim}</h2>
            <div class="text-gray-700 leading-relaxed space-y-3" set:html={r.szoveg} />
          </section>
        ))}
      </div>
    )}

    <h2 class="text-2xl font-semibold text-gray-800 mb-4 mt-8">Mire figyelj {nevLower} vásárlásakor?</h2>
    <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-8">
      <li>Kérj írásos árajánlatot, és hasonlítsd össze legalább 3 kereskedő ajánlatát.</li>
      <li>Nagyobb mennyiségnél mindig alkudj kedvezményre – 5–15% általában elérhető.</li>
      <li>Ellenőrizd a minőségi tanúsítványokat és a CE jelölést.</li>
      <li>A szállítási díj sokszor nincs benne az egységárban – ezt is számold hozzá.</li>
      <li>Vásárolj 5–10%-kal többet a tervezett mennyiségnél a veszteségekre.</li>
    </ul>

    <h2 class="text-2xl font-semibold text-gray-800 mb-4">{anyag.nev} ára városonként</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-8">
      {varosok.map((v: any) => {
        const szorzo = arData.varos_szorzok[v.slug] || 1;
        const helyi_ar = Math.round(atlag * szorzo);
        return (
          <a
            href={`/${anyag.slug}-ara-${v.slug}/`}
            class="block bg-white border border-gray-200 rounded-lg p-3 hover:border-blue-400 hover:shadow-sm transition-all"
          >
            <div class="font-medium text-gray-800 text-sm">{v.nev}</div>
            <div class="text-green-700 font-semibold text-sm">{huf(helyi_ar)} Ft</div>
          </a>
        );
      })}
    </div>

    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Gyakori kérdések – {anyag.nev} ár 2026</h2>
    <FAQ faq={arData.faq} />

    {kapcsolodo.length > 0 && (
      <div class="mt-10 pt-8 border-t border-gray-200">
        <h2 class="text-xl font-semibold text-gray-700 mb-4">Kapcsolódó anyagok</h2>
        <div class="flex flex-wrap gap-2">
          {kapcsolodo.map((k: any) => (
            <a href={`/${k.slug}-ara/`} class="bg-white border border-gray-200 rounded-lg px-4 py-2 text-sm text-gray-700 hover:border-blue-400 hover:text-blue-700 transition-all">
              {k.nev} ára →
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- ADSENSE_PLACEHOLDER -->
  </div>
</BaseLayout>
