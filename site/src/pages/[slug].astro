---
import fs from 'fs';
import path from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceTable from '../components/PriceTable.astro';
import FAQ from '../components/FAQ.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE, huf, rovidEgyseg, datumHosszu, honapEv, termekSchema } from '../lib/format';

export async function getStaticPaths() {
  const dataDir = path.resolve('..', 'data');
  const anyagok = JSON.parse(fs.readFileSync(path.join(dataDir, 'anyagok.json'), 'utf-8'));
  const varosok = JSON.parse(fs.readFileSync(path.join(dataDir, 'varosok.json'), 'utf-8'));

  const paths = [];
  for (const a of anyagok) {
    for (const v of varosok) {
      paths.push({
        params: { slug: `${a.slug}-ara-${v.slug}` },
        props: { anyag: a, varos: v, anyagok }
      });
    }
  }
  return paths;
}

const { anyag, varos, anyagok } = Astro.props;
const dataDir = path.resolve('..', 'data');
const arFajl = path.join(dataDir, 'arak', `${anyag.slug}.json`);
const arData = JSON.parse(fs.readFileSync(arFajl, 'utf-8'));

const szorzo = arData.varos_szorzok[varos.slug] || 1;
const helyiAtlag = Math.round(arData.alap_ar.atlag * szorzo);
const helyiMin = Math.round(arData.alap_ar.min * szorzo);
const helyiMax = Math.round(arData.alap_ar.max * szorzo);
const egyseg = arData.alap_ar.egyseg;
const rEgyseg = rovidEgyseg(egyseg);
const frissitve = arData.frissitve || '2026-01-15';
const loc = varos.loc || `${varos.nev}ben`;
const nevLower = anyag.nev.toLowerCase();

const helyiVariansok = arData.variansok.map((v: any) => ({
  ...v,
  ar: Math.round(v.ar * szorzo)
}));

const canonicalURL = `${SITE}/${anyag.slug}-ara-${varos.slug}/`;
const title = `${anyag.nev} ára ${loc} 2026: ${huf(helyiMin)}–${huf(helyiMax)} ${rEgyseg}`;
const description = `Mennyi a ${nevLower} ára ${loc} 2026-ban? Helyi árlista: átlagár ${huf(helyiAtlag)} ${rEgyseg}, ártartomány ${huf(helyiMin)}–${huf(helyiMax)} ${egyseg}. Frissítve: ${honapEv(frissitve)}.`;

const helyiFaq = [
  {
    kerdes: `Mennyi a ${nevLower} ára ${loc} 2026-ban?`,
    valasz: `${loc} a ${nevLower} becsült átlagára ${huf(helyiAtlag)} ${egyseg}, a sáv ${huf(helyiMin)}–${huf(helyiMax)} ${egyseg}. Az országos bolti átlag ${huf(arData.alap_ar.atlag)} ${egyseg} (bruttó, szállítás nélkül).`
  },
  {
    kerdes: `Hol lehet ${nevLower} ${loc} vásárolni?`,
    valasz: `Helyi tüzépeken, építőanyag-telepeken és barkácsáruházakban. Nagyobb tételnél a helyi telep a szállítási díj miatt gyakran olcsóbb, mint a távolabbi áruház. Érdemes 2–3 helyről írásos ajánlatot kérni.`
  },
  {
    kerdes: `Drágább a ${nevLower} ${loc}, mint az országos átlag?`,
    valasz: (szorzo > 1
      ? `A becslésünk szerint kb. ${Math.round((szorzo - 1) * 100)}%-kal magasabb az országos átlagnál.`
      : szorzo < 1
      ? `A becslésünk szerint kb. ${Math.round((1 - szorzo) * 100)}%-kal alacsonyabb az országos átlagnál.`
      : `A becslésünk szerint nagyjából az országos átlag.`)
      + ` A kereskedők listaárai országosan hasonlóak, a különbséget főleg a szállítás és a helyi telepek árazása adja.`
  }
];
const forrasDb = Array.isArray(arData.forrasok) ? arData.forrasok.length : 0;

const termek = termekSchema({
  nev: `${anyag.nev} – ${varos.nev} (${honapEv(frissitve)})`,
  leiras: description,
  kategoria: anyag.kategoria,
  url: canonicalURL,
  min: helyiMin, max: helyiMax, egyseg,
  ajanlatDb: helyiVariansok.length,
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title.substring(0, 110),
  "datePublished": "2026-01-15",
  "dateModified": frissitve,
  "author": { "@type": "Organization", "name": "epitoanyagar.hu" },
  "publisher": { "@type": "Organization", "name": "Építőanyag ár", "url": SITE },
  "url": canonicalURL
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": helyiFaq.map((f) => ({
    "@type": "Question",
    "name": f.kerdes,
    "acceptedAnswer": { "@type": "Answer", "text": f.valasz }
  }))
};

const schema = JSON.stringify([termek, articleSchema, faqSchema]);

// Kereszthivatkozás: más építőanyagok ugyanebben a városban (azonos kategória + néhány népszerű)
const nepszeru = ['cement', 'osb-lap', 'betonacél', 'terko', 'zartszelveny', 'gipszkarton', 'tegla'];
const masAnyagok = [
  ...anyagok.filter((a: any) => a.kategoria === anyag.kategoria && a.slug !== anyag.slug),
  ...anyagok.filter((a: any) => nepszeru.includes(a.slug) && a.slug !== anyag.slug && a.kategoria !== anyag.kategoria),
].slice(0, 8);
---
<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={schema}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { label: "Főoldal", href: "/" },
      { label: `${anyag.nev} ára 2026`, href: `/${anyag.slug}-ara/` },
      { label: varos.nev, href: `/${anyag.slug}-ara-${varos.slug}/` }
    ]} />

    <h1 class="text-3xl font-bold text-gray-900 mb-2">{anyag.nev} ára {loc} 2026</h1>
    <p class="text-sm text-gray-500 mb-4">
      Árak frissítve: <time datetime={frissitve}>{datumHosszu(frissitve)}</time> · {varos.nev} és környéke
    </p>

    <p class="text-gray-700 leading-relaxed mb-6">
      {loc} a <strong>{nevLower}</strong> becsült átlagára 2026-ban <strong>{huf(helyiAtlag)} {egyseg}</strong>,
      a sáv {huf(helyiMin)}–{huf(helyiMax)} {egyseg}.
      Az országos bolti átlag {huf(arData.alap_ar.atlag)} {egyseg}{forrasDb > 0 ? `, ${forrasDb} kereskedő ${datumHosszu(frissitve).replace(/\.$/, '')}-i bruttó ára alapján` : ''}; a helyi értéket ebből, a regionális árszinttel ({szorzo > 1 ? `+${Math.round((szorzo - 1) * 100)}%` : szorzo < 1 ? `−${Math.round((1 - szorzo) * 100)}%` : '±0%'}) becsüljük.
      {anyag.leiras}
    </p>
    {arData.megjegyzes && (
      <p class="text-sm text-gray-700 leading-relaxed mb-6 bg-white border-l-4 border-blue-300 pl-4 py-2">{arData.megjegyzes}</p>
    )}

    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
      <p class="text-blue-800 font-semibold text-lg">
        Becsült helyi átlagár ({varos.nev}): {huf(helyiAtlag)} {egyseg}
      </p>
      <p class="text-blue-600 text-sm">Ártartomány: {huf(helyiMin)} – {huf(helyiMax)} {egyseg}</p>
    </div>

    <h2 class="text-2xl font-semibold text-gray-800 mb-3">{anyag.nev} árlista – {varos.nev} 2026</h2>
    <PriceTable variansok={helyiVariansok} egyseg={egyseg} />

    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Gyakori kérdések</h2>
    <FAQ faq={helyiFaq} />

    {masAnyagok.length > 0 && (
      <div class="mt-10 pt-8 border-t border-gray-200">
        <h2 class="text-xl font-semibold text-gray-700 mb-4">Más építőanyagok árai {loc}</h2>
        <div class="flex flex-wrap gap-2">
          {masAnyagok.map((k: any) => (
            <a href={`/${k.slug}-ara-${varos.slug}/`} class="bg-white border border-gray-200 rounded-lg px-4 py-2 text-sm text-gray-700 hover:border-blue-400 hover:text-blue-700 transition-all">
              {k.nev} →
            </a>
          ))}
        </div>
        <p class="mt-4">
          <a href={`/varos/${varos.slug}/`} class="text-blue-600 hover:underline font-medium">
            Összes építőanyag ára {loc} →
          </a>
        </p>
      </div>
    )}

    <div class="mt-8 p-4 bg-gray-50 rounded-lg border border-gray-200">
      <p class="text-sm text-gray-600 mb-2">Vissza az összes árhoz:</p>
      <a href={`/${anyag.slug}-ara/`} class="text-blue-600 hover:underline font-medium">
        ← {anyag.nev} ára 2026 – Országos árlista
      </a>
    </div>

    <!-- ADSENSE_PLACEHOLDER -->
  </div>
</BaseLayout>
